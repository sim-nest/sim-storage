  (primary [row Route(RouteRecord { id: RouteId("route/operate-relational-data"), title: "Discover inspect migrate query mutate or mount a database relation schema SQLite site or SQL projection", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-foundation/relation-core"), why: "The provider-neutral logical relation framework owns rows, domains, and identities." }, Feature { id: FeatureId("feature/sim-shape/relation-shape"), why: "Shape admits relation values and command artifacts." }, Feature { id: FeatureId("feature/sim-codecs/sql-projection"), why: "The SQL codec is a projection of checked plans, never a command escape hatch." }, Feature { id: FeatureId("feature/sim-foundation/relation-migrate"), why: "Migration admission and drift checks precede physical action." }, Feature { id: FeatureId("feature/sim-storage/bounded-relation-site"), why: "The site contract gates provider effects and bounds." }, Feature { id: FeatureId("feature/sim-storage/sqlite-relation-locator"), why: "SQLite is selected through a closed provider identity and opaque locator." }, Feature { id: FeatureId("feature/sim-storage/relation-table-dir-projection"), why: "Results render through standard Table/Dir composition." }, Feature { id: FeatureId("feature/sim-office/office-site-workflows"), why: "Office workflows reuse relational sites rather than copying storage behavior." }, Feature { id: FeatureId("feature/sim-ledger/ledger-libraries"), why: "Ledger composition supplies durable domain reuse." }, Feature { id: FeatureId("feature/sim-sdk/relation-composition"), why: "The SDK facade exposes the supported relation composition." }, Feature { id: FeatureId("feature/sim-storage/relation-command"), why: "The loadable command parses only named, authorized, bounded operations." }, Specimen { id: SpecimenId("spec-test/sim-storage/crates/sim-lib-relation-cli/src/tests"), why: "Checked specimens cover creation, inspection, adoption, drift refusal, query, mutation, providers, and mounts." }], doc_anchor: None })] [note "route/operate-relational-data"] [section "route"])
